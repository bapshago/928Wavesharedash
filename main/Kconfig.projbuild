menu "928 EV Dash"

    config DASH_CAN_TX_GPIO
        int "CAN transceiver TX GPIO (to transceiver D/TXD)"
        range 0 54
        default 5
        help
            ESP32-P4 GPIO wired to the CAN transceiver's TXD input (SN65HVD230 pin D).
            GPIO4 and GPIO5 are free on the board's 40-pin header.

    config DASH_CAN_RX_GPIO
        int "CAN transceiver RX GPIO (from transceiver R/RXD)"
        range 0 54
        default 4
        help
            ESP32-P4 GPIO wired to the CAN transceiver's RXD output (SN65HVD230 pin R).

    config DASH_CAN_BITRATE
        int "CAN bitrate (bit/s)"
        default 500000
        help
            Nissan Leaf EV-CAN / ZombieVerter bus speed.

    config DASH_CAN_LISTEN_ONLY
        bool "Listen-only (never ACK or transmit)"
        default n
        help
            The web dash ran the controller in normal mode, which ACKs frames.
            Listen-only guarantees the dash can never disturb the bus, but on a
            bench with a single transmitter nothing will ACK its frames.

    config DASH_TEST_MODE
        bool "Test mode: animated fake data instead of CAN"
        default n
        help
            Same as TEST_MODE = true in the web dash: generates moving test data
            so the screen can be checked without a CAN bus connected.

    config DASH_BRIGHTNESS
        int "Backlight brightness (%)"
        range 5 100
        default 100

endmenu
